# Rust
/target/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Model weights and raw data are never committed (Ch. 24.1, 44.3); manifests are.
models/*
!models/MANIFEST.toml
!models/SHA256SUMS
datasets/raw/

# Local tool state
.claude/settings.local.json

# Third-party sources built locally (scripts/build_llama.sh)
/third_party/

# Embedding cache (experiments/tier3/embed.py), recomputable
/experiments/cache/
# Trained heads from experiments/tier3/train.py (results are logged in experiments/logs/tier3/)
/experiments/artifacts/

# Large router logs are committed gzipped (experiments/router/policies.py reads either form)
/experiments/logs/router/tier_outputs_clinc150.jsonl
